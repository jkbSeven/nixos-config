run
mount /dev/disk/by-label/nixos /

upload SED_PRIVATE_KEY_PATH /etc/ssh/ssh_host_ed25519_key
chmod 0600 /etc/ssh/ssh_host_ed25519_key
chown 0 0 /etc/ssh/ssh_host_ed25519_key

upload SED_PUBLIC_KEY_PATH /etc/ssh/ssh_host_ed25519_key.pub
chmod 0644 /etc/ssh/ssh_host_ed25519_key.pub
chown 0 0 /etc/ssh/ssh_host_ed25519_key.pub
